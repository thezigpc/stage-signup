{
  "id": "signup",
  "name": "Stage Signup",
  "kind": "app",
  "version": "0.2.2",
  "image": "ghcr.io/thezigpc/stage-signup:0.2.2",
  "port": 3011,
  "sdk": { "version": "0.16.0", "level": 2 },
  "routing": { "basePath": true },
  "routes": {
    "player": "/",
    "table": "/tv",
    "host": "/kj",
    "admin": "/admin"
  },
  "guests": { "path": "/kj", "cohosts": true },
  "health": "/health",
  "events": ["x-signup-added", "x-signup-next", "x-signup-ended", "x-signup-waiting", "x-signup-paused", "x-signup-new-night"],
  "brandable": ["displayName", "tagline", "accent"],
  "resources": { "memory": "256m", "cpus": 1 },
  "network": { "internet": false },
  "env": { "DATA_DIR": "/data" }
}
